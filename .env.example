# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
APP_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-32-byte-base64url-key
APP_ADMIN_EMAIL=you@example.com

# PostgreSQL
DATABASE_URL=postgresql+psycopg://outreach:outreach@localhost:5432/outreach

# Google OAuth and Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
GOOGLE_PUBSUB_AUDIENCE=

# Initial safety defaults
GLOBAL_SENDING_ENABLED=false
CONTROLLED_TEST_RECIPIENT=
DEFAULT_DAILY_SEND_LIMIT=20
DEFAULT_HOURLY_SEND_LIMIT=5
DEFAULT_TIME_ZONE=Africa/Lagos

# AI Integration (Gemini Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

